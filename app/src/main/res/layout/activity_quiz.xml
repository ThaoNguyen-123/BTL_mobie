<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_quiz_game"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Top bar: score + timer -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical">

            <!-- Score -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_score_bar"
                android:paddingStart="10dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_coin"
                    android:contentDescription="@string/cd_coin"/>

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_score"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- Timer -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_timer"
                android:paddingStart="10dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_timer"
                    android:contentDescription="@string/cd_timer"/>

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_timer"
                    android:textColor="#00FF7F"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Question info card -->
        <LinearLayout
            android:id="@+id/questionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_question_box"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:padding="16dp">

            <!-- Question number + topic row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvQuestionNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_question_num"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:background="@drawable/bg_info_pill"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tvTopicLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/topic_placeholder"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:background="@drawable/bg_info_pill"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
            </LinearLayout>

            <!-- Question text -->
            <TextView
                android:id="@+id/tvQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/question_placeholder"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="12dp"
                android:paddingBottom="4dp"/>
        </LinearLayout>

        <!-- Help buttons: 50/50, X2, PAUSE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btn5050"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/help_5050"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@color/colorHelpButton"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnX2"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/help_x2"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@color/colorHelpButton"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnPause"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/help_pause"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@color/colorHelpButton"/>
        </LinearLayout>

        <!-- Answer A -->
        <LinearLayout
            android:id="@+id/layoutAnswerA"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_answer_button"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true">

            <RadioButton
                android:id="@+id/rbA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#FFFFFF"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/cd_option_a"/>

            <TextView
                android:id="@+id/tvAnswerA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/answer_a_placeholder"
                android:textColor="@color/white"
                android:textSize="15sp"/>
        </LinearLayout>

        <!-- Answer B -->
        <LinearLayout
            android:id="@+id/layoutAnswerB"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_answer_button"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true">

            <RadioButton
                android:id="@+id/rbB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#FFFFFF"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/cd_option_b"/>

            <TextView
                android:id="@+id/tvAnswerB"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/answer_b_placeholder"
                android:textColor="@color/white"
                android:textSize="15sp"/>
        </LinearLayout>

        <!-- Answer C -->
        <LinearLayout
            android:id="@+id/layoutAnswerC"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_answer_button"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true">

            <RadioButton
                android:id="@+id/rbC"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#FFFFFF"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/cd_option_c"/>

            <TextView
                android:id="@+id/tvAnswerC"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/answer_c_placeholder"
                android:textColor="@color/white"
                android:textSize="15sp"/>
        </LinearLayout>

        <!-- Answer D -->
        <LinearLayout
            android:id="@+id/layoutAnswerD"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_answer_button"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true">

            <RadioButton
                android:id="@+id/rbD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#FFFFFF"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/cd_option_d"/>

            <TextView
                android:id="@+id/tvAnswerD"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/answer_d_placeholder"
                android:textColor="@color/white"
                android:textSize="15sp"/>
        </LinearLayout>

        <!-- Confirm / Next button -->
        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/confirm"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:letterSpacing="0.08"
            android:backgroundTint="@color/colorPrimaryDark"
            android:layout_marginTop="20dp"/>

    </LinearLayout>
</ScrollView>
